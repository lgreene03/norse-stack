# Norse Stack — environment template.
#
# Copy to `.env` and replace the placeholders with real local values:
#   cp .env.example .env
#
# docker-compose.yml reads these via ${VAR:-default}. The defaults baked into
# compose keep `docker compose up` working out-of-the-box for local dev, but a
# real deployment MUST override every value here. NEVER commit a populated .env.
#
# Do NOT copy this file over a stack that already runs on the compose defaults.
# Its placeholder credentials would replace the ones MinIO and the existing
# Postgres databases were created with, and muninn and huginn could no longer
# log in. Write .env by hand with only the lines that machine needs instead
# (for the owner's Mac, the three in docs/RUNBOOK.md, section 6).

# ── Datastore credentials ─────────────────────────────────────────────────
# Postgres password for the Muninn metadata DB (user: muninn).
MUNINN_DB_PASSWORD=change-me-muninn-db
# Postgres password for the Huginn DB (user: postgres).
HUGINN_DB_PASSWORD=change-me-huginn-db

# ── Object storage (MinIO / S3) ───────────────────────────────────────────
MINIO_ROOT_USER=change-me-minio-user
MINIO_ROOT_PASSWORD=change-me-minio-secret

# ── Host-specific settings (leave unset unless this machine needs them) ───
# Host folder holding MinIO's data, which is every raw recording muninn makes
# (bucket muninn-raw). Default ./data/minio, inside this checkout and ignored by
# git. Use an absolute path; quote it if it contains spaces. Before pointing it
# at a folder that already holds data, read docs/RUNBOOK.md, section 6.
# MINIO_DATA_DIR="/Volumes/Mac 4T/norse/minio"
#
# Whether Docker may create MINIO_DATA_DIR when it does not exist. Default true,
# so a fresh clone starts with no setup. Set false whenever MINIO_DATA_DIR is
# set: a mistyped path or a folder that has gone missing then stops MinIO from
# starting, instead of starting it on a new, empty folder that the recorder
# would quietly fill in place of the real one.
# MINIO_DATA_DIR_CREATE=false
#
# Host port for Muninn's API (default 8080). Only the host side changes; the
# stack still reaches Muninn at muninn:8080. Set it when 8080 is already taken.
# MUNINN_HOST_PORT=18080
#
# Folder holding the research datasets mirrored from data.binance.vision (public
# klines, funding and premium index; see docs/research/data-coverage.md). Read by
# the research tools in research/, not by any container. There is no default: the
# tools refuse to run until it is set, so gigabytes never land somewhere unplanned.
# NORSE_DATASETS_DIR="/Volumes/Mac 4T/norse/datasets"

# ── Observability ─────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# ── Control-plane bearer tokens ───────────────────────────────────────────
# Gate the mutating HTTP endpoints on Huginn and Sleipnir. Auth fails closed
# when set; leave empty ONLY for a fully trusted local network.
HUGINN_API_TOKEN=localdev-change-me
SLEIPNIR_ADMIN_TOKEN=localdev-change-me

# ── Python analytics services: CORS hardening (optional) ──────────────────
# The read-only HTTP APIs on odin/bragi/huginn-ai/news-sentinel default to
# Access-Control-Allow-Origin: * to keep local dashboards working. In a
# hardened deployment set this to the single dashboard origin instead, e.g.
# ACCESS_CONTROL_ALLOW_ORIGIN=https://dashboards.internal.example
# Leaving it unset preserves the permissive "*" default (non-breaking).
ACCESS_CONTROL_ALLOW_ORIGIN=*
